# Copy this file to .env and fill in real values for LOCAL DEVELOPMENT ONLY.
# Never commit the filled-in .env file — it's already in .gitignore.
# On HF Spaces, set these as secrets instead (see README.md).

GROQ_API_KEY=your_primary_groq_key_here
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_API_KEY_4=

TAVILY_API_KEY=your_tavily_key_here

# Optional: handwriting OCR fallback (uses your GROQ_API_KEY above with a
# vision-capable model). Leave unset to use the defaults below.
# GROQ_VISION_MODEL=qwen/qwen3.6-27b
# ENABLE_HANDWRITING_FALLBACK=true
# MIN_OCR_RESULT_CHARS=20

# Optional: Mistral OCR fallback, tried before the handwriting fallback
# above when EasyOCR's own result on a scanned page looks unreliable.
# Stronger than EasyOCR on real-world (not clean) Hindi/Marathi/Tamil/
# etc. scans, at the cost of a paid, network-dependent API call. Leave
# MISTRAL_API_KEY unset to skip this tier entirely and keep OCR fully
# free/offline (EasyOCR + handwriting fallback still apply).
# MISTRAL_API_KEY=your_mistral_key_here
# MISTRAL_OCR_MODEL=mistral-ocr-latest
# ENABLE_MISTRAL_OCR_FALLBACK=true
